# ===========================================================================
# AutoBot configuration — copy to .env and fill in what you need.
# Every key is optional except DISCORD_BOT_TOKEN. Missing keys disable the
# related integration instead of crashing the bot.
# ===========================================================================

# --- Discord ---------------------------------------------------------------
DISCORD_BOT_TOKEN=
# Prefix for legacy text commands (!agent, !doctor, !ping)
COMMAND_PREFIX=!
# Optional: sync slash commands instantly to these guild ids (comma separated).
# Leave empty to publish globally (can take up to 1 hour to appear).
DEV_GUILD_IDS=
# Fallback channel for feature alerts when a server has not configured one.
DEFAULT_ALERT_CHANNEL_ID=
# Enables the privileged "Server Members" intent (not required).
ENABLE_MEMBERS_INTENT=false
# Fallback max size for generated videos (MB). CINEMATIC_MAX_UPLOAD_MB overrides it.
# Servers without boosts only allow 10 MB uploads.
MAX_UPLOAD_MB=24

# --- Gemini (script writing, mood understanding, market analysis) ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.9

# --- Storage / logging -----------------------------------------------------
DATA_DIR=data
DATABASE_PATH=data/autobot.db
LOG_LEVEL=INFO
ENVIRONMENT=production

# --- 1. Leak monitor -------------------------------------------------------
LEAK_MONITOR_ENABLED=true
# How often to run a scan cycle (seconds, min 120)
LEAK_SCAN_INTERVAL=900
# Per-source cooldown cap (seconds)
LEAK_MIN_SOURCE_INTERVAL=1800
LEAK_ALERT_CHANNEL_ID=
# Have I Been Pwned API key (paid): https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# GitHub token enables code search for leaked configs (optional)
GITHUB_TOKEN=
LEAK_SOURCE_RANSOMWATCH=true
LEAK_SOURCE_PSBDMP=true
LEAK_SOURCE_HUDSONROCK=true
LEAK_MAX_ALERTS_PER_CYCLE=10
LEAK_REQUEST_TIMEOUT=20
LEAK_SNIPPET_CHARS=400

# --- 2. Cinematic director -------------------------------------------------
CINEMATIC_ENABLED=true
# Free Pexels key: https://www.pexels.com/api/
# Without it, the bot uses picsum.photos still images with a Ken Burns effect.
PEXELS_API_KEY=
CINEMATIC_WORKDIR=data/cinematic
# Put royalty-free mp3 files here to get background music
CINEMATIC_MUSIC_DIR=assets/music
CINEMATIC_MAX_SECONDS=60
CINEMATIC_MAX_SCENES=8
CINEMATIC_KEEP_JOBS=5
CINEMATIC_MAX_UPLOAD_MB=24
# Use local demo scripts when Gemini is unavailable (true) or fail (false)
CINEMATIC_DEMO_MODE=true
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Neural voices (edge-tts). A bn-* voice is picked automatically for Bangla text.
CINEMATIC_VOICES=en-US-AriaNeural,en-US-GuyNeural,en-GB-RyanNeural,bn-BD-NabanitaNeural,bn-IN-BashkarNeural
# Must be a font installed on the host (install fonts-noto-bengali for Bangla)
CAPTION_FONT=DejaVu Sans
CAPTION_SIZE=62
# Optional YouTube Shorts upload (see scripts/youtube_auth.py)
YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_FILE=

# --- 3. AI DJ --------------------------------------------------------------
DJ_ENABLED=true
DJ_VOLUME=0.5
DJ_MAX_QUEUE=50
DJ_AUTOPLAY=true
DJ_IDLE_DISCONNECT=120
# Spotify is used for curation only (playback happens on YouTube)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Cookies help when YouTube asks a datacenter IP to sign in
YTDLP_COOKIES_FILE=

# --- 4. Market sniper ------------------------------------------------------
SNIPER_ENABLED=true
SNIPER_ALERT_INTERVAL=120
SNIPER_ALERT_CHANNEL_ID=
# Optional CoinGecko demo key (higher rate limits): https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# Optional X/Twitter bearer token for tweet-volume sentiment
X_BEARER_TOKEN=
# Optional Finnhub key for /sniper stock (free tier): https://finnhub.io/
FINNHUB_API_KEY=
REDDIT_SUBREDDITS=CryptoCurrency,CryptoMoonShots,SatoshiStreetBets,memecoins
SNIPER_CACHE_TTL=60
SNIPER_REQUEST_TIMEOUT=20
